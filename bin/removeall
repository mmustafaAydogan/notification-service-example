#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$ROOT_DIR"

echo "This will remove all containers, volumes (mariadb, redis, rabbitmq, mongo)"
echo "and the local notification_php image."
echo ""
read -r -p "Are you sure? [y/N] " REPLY
echo ""

if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 0
fi

echo "Removing containers, volumes and local images..."
docker compose down -v --remove-orphans --rmi local

echo ""
echo "Done."
