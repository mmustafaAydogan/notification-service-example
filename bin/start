#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$ROOT_DIR"

echo "Starting Notification System..."

docker compose up -d --build --wait --scale worker=0 --scale scheduler=0

echo "Installing Composer dependencies..."
docker compose exec -T php composer install --no-interaction --prefer-dist

echo "Running migrations..."
docker compose exec -T php php artisan migrate --force

echo "Generating API documentation..."
docker compose exec -T php php artisan l5-swagger:generate

echo "Starting worker and scheduler..."
docker compose up -d worker scheduler

echo ""
echo "Done."
echo "API:       http://localhost:8080"
echo "API Docs:  http://localhost:8080/api/documentation"
echo "RabbitMQ:  http://localhost:15672 (notification_user / notification_pass)"
